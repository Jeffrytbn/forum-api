{
  "name": "forum-api",
  "version": "1.0.0",
  "description": "Forum API - Submission Automation Testing & Clean Architecture",
  "main": "src/app.js",
  "scripts": {
    "start": "node src/app.js",
    "start:dev": "nodemon src/app.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "migrate": "node-pg-migrate",
    "migrate:test": "node-pg-migrate -f config/database/test.json"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "bcrypt": "^5.1.1",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "instances-container": "^2.0.6",
    "jsonwebtoken": "^9.0.2",
    "nanoid": "^3.3.7",
    "node-pg-migrate": "^6.2.2",
    "pg": "^8.11.5"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "^1.6.0",
    "nodemon": "^3.1.0",
    "supertest": "^7.0.0",
    "vitest": "^1.6.0"
  }
}
